<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Révisions"
            android:textColor="#F4F4F5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- À l'arrêt : texte fixe (un Chronometer arrêté se recalcule à l'affichage et dérive). -->
        <TextView
            android:id="@+id/chrono_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00:00"
            android:textColor="#F4F4F5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/chrono"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#F4F4F5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="aujourd'hui"
            android:textColor="#A1A1AA"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/toggle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_btn"
        android:contentDescription="Démarrer ou mettre en pause"
        android:padding="13dp"
        android:src="@drawable/ic_play" />
</LinearLayout>
