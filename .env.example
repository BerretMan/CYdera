# Variables d'environnement reconnues par Cydera et ses scripts.
# Copier en `.env` (ignoré par Git) et remplir au besoin. Ne jamais commiter de valeurs réelles.

# Mot de passe ENT/Celcat (sinon : fichier enregistré par l'écran de connexion, puis ~/CELCAT_PASSWORD).
CELCAT_PASSWORD=
# Mot de passe du webmail étudiant (sinon : ~/CYU_MAIL_PASSWORD, puis celui de Celcat).
CYU_MAIL_PASSWORD=

# Mot de passe du keystore de signature Android (build-apk.sh release).
CYDERA_KS_PASS=
# Chemin du keystore de signature (défaut : ~/cydera.jks).
CYDERA_KS=
# ABI Android à compiler (défaut : « arm64-v8a armeabi-v7a » ; « x86_64 » pour l'émulateur).
CYDERA_ABIS=

# 1 = trace les étapes SSO du webmail (sans afficher de valeurs).
CYDERA_MAIL_DEBUG=
# Simule une version plus ancienne pour tester la mise à jour (ex. 0.0.1).
CYDERA_UPDATE_FROM=
